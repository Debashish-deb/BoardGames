{
  "name": "BoardGameLegends",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile App version of BoardGame Legends",
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=14.17"
  },
  "files": [
    "bin",
    "lib",
    "!lib/enu",
    "LICENSE.txt",
    "README.md",
    "SECURITY.md",
    "ThirdPartyNoticeText.txt",
    "!**/.gitattributes"
  ],
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@dprint/formatter": "^0.4.1",
    "@dprint/typescript": "0.93.4",
    "@esfx/canceltoken": "^1.0.0",
    "@eslint/js": "^9.20.0",
    "@octokit/rest": "^21.1.1",
    "@types/chai": "^4.3.20",
    "@types/diff": "^7.0.1",
    "@types/minimist": "^1.2.5",
    "@types/mocha": "^10.0.10",
    "@types/ms": "^0.7.34",
    "@types/node": "latest",
    "@types/source-map-support": "^0.5.10",
    "@types/which": "^3.0.4",
    "@typescript-eslint/rule-tester": "^8.24.1",
    "@typescript-eslint/type-utils": "^8.24.1",
    "@typescript-eslint/utils": "^8.24.1",
    "azure-devops-node-api": "^14.1.0",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "chokidar": "^4.0.3",
    "diff": "^8.0.3",
    "dprint": "^0.49.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "eslint-formatter-autolinkable-stylish": "^1.4.0",
    "eslint-plugin-regexp": "^2.7.0",
    "fast-xml-parser": "^4.5.2",
    "glob": "^10.4.5",
    "globals": "^15.15.0",
    "hereby": "^1.10.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^5.44.4",
    "minimist": "^1.2.8",
    "mocha": "^10.8.2",
    "mocha-fivemat-progress-reporter": "^0.1.0",
    "monocart-coverage-reports": "^2.12.1",
    "ms": "^2.1.3",
    "picocolors": "^1.1.1",
    "playwright": "^1.50.1",
    "source-map-support": "^0.5.21",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "which": "^3.0.1"
  },
  "overrides": {
    "typescript@*": "$typescript"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:eslint-rules": "npm run lint",
    "build": "npm run build:app && npm run test:unit",
    "build:app": "tsc --project tsconfig.json",
    "build:tests": "npm run test:unit",
    "build:tests:notypecheck": "npm run test:unit",
    "clean": "node scripts/clean.mjs",
    "gulp": "npm run build",
    "lint": "eslint ./src --ext .ts,.tsx",
    "knip": "knip",
    "format": "dprint fmt",
    "setup-hooks": "node scripts/link-hooks.mjs",
    "test:unit": "tsc --project tsconfig.json --noEmit"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false,
    "crypto": false,
    "buffer": false,
    "source-map-support": false,
    "inspector": false,
    "perf_hooks": false
  },
  "packageManager": "npm@8.19.4",
  "volta": {
    "node": "20.1.0",
    "npm": "8.19.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "expo": "52.0.32",
    "@expo/vector-icons": "^15.0.3",
    "@improbable-eng/grpc-web-node-http-transport": "^0.15.0",
    "@nozbe/watermelondb": "^0.25.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/material-top-tabs": "^7.4.13",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@react-navigation/stack": "^7.7.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/lz-string": "^1.3.34",
    "base64-arraybuffer": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "chess.js": "^1.4.0",
    "expo-blur": "^15.0.8",
    "expo-haptics": "^15.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-status-bar": "^3.0.9",
    "grpc-web": "^2.0.2",
    "immer": "^11.1.4",
    "js-sha256": "^0.11.1",
    "lz-string": "^1.5.0",
    "protobufjs": "^8.0.0",
    "react-native-device-info": "^15.0.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-keychain": "^10.0.0",
    "react-native-paper": "^5.15.0",
    "react-native-permissions": "^5.4.4",
    "react-native-quick-base64": "^2.2.2",
    "react-native-randombytes": "^3.6.2",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-vector-icons": "^10.3.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.182.0",
    "zustand": "^5.0.11"
  }
}